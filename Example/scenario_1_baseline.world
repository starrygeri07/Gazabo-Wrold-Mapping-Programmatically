<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="baseline_efficiency_world">
    
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>false</shadows>
    </scene>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
      </ode>
    </physics>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0 0 18 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <model name='baseline_enclosure'>
      <static>1</static>
      <pose frame=''>0 0 0 0 0 0</pose>
      
      <link name='wall_north'>
        <pose>0 5 0.5 0 0 0</pose>
        <collision name='collision'>
          <geometry><box><size>10.2 0.2 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/FlatBlack</name> </script>
          </material>
        </visual>
      </link>

      <link name='wall_south'>
        <pose>0 -5 0.5 0 0 0</pose>
        <collision name='collision'>
          <geometry><box><size>10.2 0.2 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/FlatBlack</name> </script>
          </material>
        </visual>
      </link>

      <link name='wall_east'>
        <pose>5 0 0.5 0 0 0</pose>
        <collision name='collision'>
          <geometry><box><size>0.2 10.2 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.2 10.2 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/FlatBlack</name> </script>
          </material>
        </visual>
      </link>

      <link name='wall_west'>
        <pose>-5 0 0.5 0 0 0</pose>
        <collision name='collision'>
          <geometry><box><size>0.2 10.2 1.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.2 10.2 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/FlatBlack</name> </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
